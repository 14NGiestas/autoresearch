#!/usr/bin/env bash
# build_arch — constroi um binario para UMA arch, SEM editar a fonte.
#
# Por que existe: a arch estava em `integer, parameter` no fonte, e construir
# outra arch significava editar o arquivo, compilar e reverter -- com dois
# problemas reais: (1) o arquivo e' compartilhado, entao editar abre corrida com
# qualquer outro build (outro agente, outro terminal); (2) a fonte pode ficar na
# arch errada e ser commitada (foi exatamente o que deixou a arvore em d216 com
# os experimentos em d96). Agora os defaults sao #define ARCH_* e a arch vira
# DEFINE de compilacao -- o fpm ja' compila nossos fontes com -cpp.
#
# O binario se identifica sozinho: a identidade (arch_id) e' derivada dos
# parametros compilados, entao este script imprime a identidade do que construiu.
#
# Uso:
#   bin/build_arch D HEADS KV LAYERS VOCAB CTX [BUILD_DIR] [--release]
#   bin/build_arch 96 6 2 12 8192 1024 /tmp/b96
#
# Nada aqui toca src/build/: o BUILD_DIR e' seu (default /tmp/build_arch_<arch>).
set -eu
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ $# -lt 6 ]; then
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
fi
D=$1; H=$2; KV=$3; L=$4; V=$5; C=$6
BD=${7:-/tmp/build_arch_d${1}_h${2}_kv${3}_l${4}_v${5}_c${6}}
REL=""
[ "${8:-}" = "--release" ] && REL="--profile release"
# OTIMIZACAO. Medido em 2026-09-20 (bench_attn_split, mesmo binario): 10,8 ms com o
# perfil default (debug = -O0) contra 4,4 ms com -O2, ou seja 2,4x. O projeto
# treinou TODOS os runs ate' hoje sem otimizacao.
#
# Por que --flag e nao profile: o manifesto NAO aceita flags de compilador em
# perfil (ver a nota em src/fpm.toml), e --profile (CLI) nao convive com
# --features ("--profile and --features cannot be used together"), e a arch E' uma
# feature. O --flag convive com --features, e o ultimo -O vence.
# Sobrescreve:  OPT="-O3 -march=native" bin/build_arch ...
OPT="${OPT:--O2}"
OPTFLAG="--flag '$OPT'"

case "$BD" in
  */src/build/*|src/build/*) echo "build_arch: recuse --build-dir dentro de src/build (arvore viva dos jobs)"; exit 2 ;;
esac

# Caminho declarativo (preferido): a arch esta declarada em src/fpm.toml como
# feature, e o fpm aplica os macros do cpp. Sem editar nada, escolhido na
# invocacao -- e' o suporte NATIVO do fpm a variaveis de preprocessamento
# ([features].<nome>.preprocess.cpp.macros).
TAG="arch_d${D}_h${H}_kv${KV}_l${L}_v${V}_c${C}"
if grep -qE "^${TAG} *=" src/fpm.toml; then
  MODE="--features $TAG $OPTFLAG"
  echo "[build_arch] feature declarada em src/fpm.toml: $TAG"
else
  # Fallback: valor arbitrario nao declarado. --flag e' suportado pelo fpm e
  # vale para as dependencias tambem (macros ARCH_* so' sao lidas por nos).
  MODE="--flag '-cpp -DARCH_D_MODEL=$D -DARCH_N_HEAD=$H -DARCH_N_KV=$KV -DARCH_N_LAYER=$L -DARCH_VOCAB=$V -DARCH_CTX=$C'"
  echo "[build_arch] feature $TAG NAO declarada -> fallback --flag -D..."
  echo "[build_arch]   (para o caminho declarativo, adicione a feature em src/fpm.toml)"
fi
echo "[build_arch] d=$D heads=$H kv=$KV layers=$L vocab=$V ctx=$C  (HD=$((D/H)))"
echo "[build_arch] build: $BD"
# NAO esconder o erro com `| tail -1`. Foi assim que eu perdi tempo no
# halfbeast: o build falhava (faltava a dependencia de caminho energy-fortran) e
# o script so' dizia "nenhum dir app", sem causa. E pior: ele SEGUIA com codigo 0,
# entao um build falho passava por sucesso. Agora: guarda a saida, e se o build
# falhar, mostra as ultimas linhas do erro e sai 5.
# `if ! ...` e' obrigatorio aqui: o script roda com set -e, entao uma atribuicao
# que falha aborta ANTES da checagem (foi o que aconteceu na primeira tentativa:
# rc=1 e nenhuma mensagem).
if ! OUT=$(nix develop "${NIX_SHELL:-.#cpu-only}" --command bash -c \
    "cd src && fortran-fpm build $REL $MODE --build-dir '$BD'" 2>&1); then
  echo "[build_arch] BUILD FALHOU. Ultimas 12 linhas do erro:"
  printf '%s\n' "$OUT" | tail -12 | sed 's/^/  /'
  exit 5
fi
printf '%s\n' "$OUT" | tail -1 | sed 's/^/  /'

# GRAVA A ARCH. O nome do diretorio e' convencao, nao contrato: quem renomeia o
# dir muda o significado em silencio. A fonte da verdade e' este arquivo, escrito
# aqui, com os parametros que ESTE build recebeu. O formato e' o mesmo do arch.txt
# do checkpoint, entao um leitor so' serve para os dois.
mkdir -p "$BD"
{
  echo "d_model = $D"
  echo "n_head = $H"
  echo "n_kv = $KV"
  echo "n_layer = $L"
  echo "vocab = $V"
  echo "ctx = $C"
  echo "head_dim = $((D/H))"
  echo "# escrito pelo build_arch; lido pelo job_env (mesmo formato do checkpoint)"
} > "$BD/arch.txt"
echo "[build_arch] arch registrada em $BD/arch.txt"

# Publica os caminhos dos apps. O fpm guarda UMA configuracao por --build-dir
# (passamos sempre um dir dedicado), entao "exatamente um diretorio de app" e' um
# invariante VERIFICAVEL, nao adivinhacao. O que quebrou o job 155 foi o
# `tail -1` sobre um glob que casava varios: ele escolheu o binario kv2 para um
# checkpoint kv1. Aqui, mais de um match e' ERRO, nao escolha.
APPS=$(ls -d "$BD"/*/app 2>/dev/null | grep . || true)
N=$(printf '%s' "$APPS" | grep -c . || true)
if [ "$N" = "1" ]; then
  # Publica TODOS os executaveis do dir app, nao uma lista fixa: uma lista fixa
  # esqueceu o repl, e esquecer e' a mesma doenca do glob (o consumidor adivinha).
  for P in "$APPS"/*; do
    [ -x "$P" ] || continue
    case "$P" in *.o|*.mod|*.smod) continue ;; esac
    echo "[build_arch] app $(basename "$P") $P"
  done
elif [ "$N" = "0" ]; then
  echo "[build_arch] nenhum dir app em $BD (build falhou?)"
else
  echo "[build_arch] AMBIGUO: $N dirs app em $BD; um --build-dir tem UMA config"
  printf '%s\n' "$APPS" | sed 's/^/    /'
  exit 3
fi
